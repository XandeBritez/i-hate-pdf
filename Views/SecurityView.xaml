<UserControl x:Class="IHatePdf.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:IHatePdf.Behaviors"
             xmlns:models="clr-namespace:IHatePdf.Models"
             xmlns:vm="clr-namespace:IHatePdf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SecurityViewModel}"
             mc:Ignorable="d">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Senha" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                       Text="Coloca ou tira a senha de abertura, sempre em uma copia. Remover a senha exige saber a senha: o app nao quebra protecao." />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
            <Button Content="Adicionar PDFs" Style="{StaticResource GhostButton}" Margin="0,0,26,8" Command="{Binding AddFilesCommand}" />
            <Button Content="Remover" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" />
            <Button Content="Limpar" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Command="{Binding ClearCommand}" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Acao"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5" />

                    <RadioButton GroupName="Acao"
                                 IsChecked="{Binding ProtectMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,18,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock>
                            <Run Text="Proteger" FontWeight="SemiBold" />
                            <Run Text="- exige senha para abrir" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                    </RadioButton>

                    <RadioButton GroupName="Acao"
                                 IsChecked="{Binding ProtectMode, Converter={StaticResource InverseBool}}"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock>
                            <Run Text="Remover senha" FontWeight="SemiBold" />
                            <Run Text="- gera uma copia aberta" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                    </RadioButton>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Text="Senha" />

                    <PasswordBox Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Padding="8,6"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 b:PasswordBoxBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- A confirmacao so existe ao proteger: errar a senha ali
                         deixaria o arquivo inacessivel para sempre. -->
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Margin="18,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Text="Confirmar"
                               Visibility="{Binding ProtectMode, Converter={StaticResource BoolToVisibility}}" />

                    <PasswordBox Grid.Column="3"
                                 VerticalAlignment="Center"
                                 Padding="8,6"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Visibility="{Binding ProtectMode, Converter={StaticResource BoolToVisibility}}"
                                 b:PasswordBoxBehavior.BoundPassword="{Binding PasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Pasta de saida"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5" />

                    <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />

                    <Button Grid.Column="2" Content="Escolher..."
                            Margin="12,0,0,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ChooseOutputFolderCommand}" />

                    <Button Grid.Column="3" Content="Abrir pasta"
                            Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding OpenOutputFolderCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DropZoneBorder}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource GlyphText}"
                               FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Solte os PDFs aqui"
                               FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Style="{StaticResource PlainListBox}"
                         Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding ErrorMessage}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SourcePath}"
                                               Style="{StaticResource SubtitleText}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock x:Name="StatusText"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Status, Converter={StaticResource ConversionStatusToText}}" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Concluido}">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Erro}">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SubtitleText}" />
            <Button Content="{Binding ActionLabel}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Command="{Binding ApplyCommand}" />
        </Grid>
    </Grid>
</UserControl>
