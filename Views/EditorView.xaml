<UserControl x:Class="IHatePdf.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:vm="clr-namespace:IHatePdf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             mc:Ignorable="d">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Editar paginas" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                       Text="Marque as paginas para excluir, arraste os cards para reordenar e adicione paginas de outros PDFs." />
            <TextBlock Text="{Binding CurrentFileName}" Margin="0,8,0,0"
                       FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <!-- Tres grupos: entrada do documento, acoes de selecao, sair.
             Espaco apertado dentro do grupo, generoso entre grupos. -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
            <Button Content="Abrir PDF" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" />
            <Button Content="Adicionar paginas" Style="{StaticResource GhostButton}" Command="{Binding AddPagesCommand}" Margin="0,0,26,8" />

            <Button Content="Selecionar tudo" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" />
            <Button Content="Limpar selecao" Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}" />
            <Button Content="Excluir selecionadas" Style="{StaticResource GhostButton}" Command="{Binding DeleteSelectedCommand}" Margin="0,0,26,8" />

            <Button Content="Fechar" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" Margin="0,0,0,8" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource DropZoneBorder}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Pages.Count, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="&#xE7C3;" Style="{StaticResource GlyphText}"
                               FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Solte um PDF aqui para editar suas paginas"
                               FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Grade de miniaturas com reordenacao por arrastar -->
                <ListBox ItemsSource="{Binding Pages}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Pages.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.SelectDroppedItems="False"
                         dd:DragDrop.DragAdornerTemplate="{StaticResource DragCardAdorner}"
                         dd:DragDrop.DropTargetAdornerBrush="{DynamicResource AccentBrush}"
                         dd:DragDrop.DragMouseAnchorPoint="0.5,0.5"
                         dd:DragDrop.MinimumHorizontalDragDistance="6"
                         dd:DragDrop.MinimumVerticalDragDistance="6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,14,14" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Width="180"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Cursor="Hand"
                                    ToolTip="Arraste para mudar a posicao desta pagina">
                                <StackPanel>
                                    <Grid Height="200">
                                        <!-- A folha ganha borda e sombra para nao se fundir com o card. -->
                                        <Border Background="White"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxHeight="200">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000" />
                                            </Border.Effect>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <!-- Placeholder por cima do fundo branco enquanto a miniatura nao chega -->
                                        <TextBlock Text="Renderizando..."
                                                   Style="{StaticResource SubtitleText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Posicao atual: o numero que a pagina tera no PDF salvo -->
                                        <Border Style="{StaticResource CardBadge}"
                                                HorizontalAlignment="Left"
                                                ToolTip="Posicao desta pagina no PDF que sera salvo">
                                            <TextBlock Text="{Binding DisplayNumber, Mode=OneWay}"
                                                       Style="{StaticResource CardBadgeText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>

                                        <!-- Numeracao de origem, so quando a pagina saiu do lugar -->
                                        <Border Style="{StaticResource CardBadge}"
                                                HorizontalAlignment="Right"
                                                ToolTip="Posicao desta pagina no arquivo de origem"
                                                Visibility="{Binding HasMoved, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CardBadgeText}">
                                                <Run Text="era" />
                                                <Run Text="{Binding OriginalNumber, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Marcar para excluir" />

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5">
                                                <Run Text="Pagina" />
                                                <Run Text="{Binding DisplayNumber, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <!-- Origem so aparece quando a pagina veio de outro arquivo. -->
                                            <TextBlock Text="{Binding SourceFileName}"
                                                       Style="{StaticResource SubtitleText}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       ToolTip="{Binding SourcePath}"
                                                       Visibility="{Binding IsFromOtherFile, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <!-- Pairar ja indica que o card e agarravel -->
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SubtitleText}" />
            <Button Content="Salvar como novo PDF"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Command="{Binding SaveAsCommand}" />
        </Grid>
    </Grid>
</UserControl>
