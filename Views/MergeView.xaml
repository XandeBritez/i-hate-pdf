<UserControl x:Class="IHatePdf.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:b="clr-namespace:IHatePdf.Behaviors"
             xmlns:vm="clr-namespace:IHatePdf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MergeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Unir PDFs" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                       Text="Arraste os PDFs para a area abaixo. A ordem da lista e a ordem do documento final; arraste os itens para reordenar." />
        </StackPanel>

        <!-- Barra de acoes -->
        <!-- Grupos: adicionar | reordenar | remover. -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
            <Button Content="Adicionar PDFs"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,26,8"
                    Command="{Binding AddFilesCommand}" />

            <Button Content="Subir"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding MoveUpCommand}" />
            <Button Content="Descer"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,26,8"
                    Command="{Binding MoveDownCommand}" />

            <Button Content="Remover"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding RemoveCommand}" />
            <Button Content="Limpar"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,0,8"
                    Command="{Binding ClearCommand}" />
        </WrapPanel>

        <!-- Lista / drop zone -->
        <Border Grid.Row="2" Style="{StaticResource DropZoneBorder}">
            <Grid>
                <!-- Placeholder quando a fila esta vazia -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Files.Count, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource GlyphText}"
                               FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Solte seus arquivos PDF aqui"
                               FontSize="15" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="ou use o botao Adicionar PDFs"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Grade de capas: mesmo layout do editor de paginas.
                     gong-wpf-dragdrop cuida da reordenacao por arrastar. -->
                <ListBox ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Files.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.UseDefaultDragAdorner="True"
                         dd:DragDrop.SelectDroppedItems="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,14,14" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Width="180"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    ToolTip="{Binding FilePath}">
                                <StackPanel>
                                    <Grid Height="200">
                                        <!-- A folha ganha borda e sombra para nao se fundir com o card. -->
                                        <Border Background="White"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxHeight="200">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000" />
                                            </Border.Effect>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <!-- Placeholder por cima do fundo branco enquanto a capa nao chega -->
                                        <TextBlock Text="Renderizando..."
                                                   Style="{StaticResource SubtitleText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Ordem no documento final -->
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Margin="6"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="{Binding DisplayNumber, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding FileName}"
                                               Margin="0,10,0,0"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" FontSize="10.5">
                                        <Run Text="{Binding PageCount, Mode=OneWay}" />
                                        <Run Text="pagina(s) -" />
                                        <Run Text="{Binding DisplaySize, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Rodape -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SubtitleText}" />
            <Button Content="Unir e salvar PDF"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Command="{Binding MergeCommand}" />
        </Grid>
    </Grid>
</UserControl>
