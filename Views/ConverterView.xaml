<UserControl x:Class="IHatePdf.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:models="clr-namespace:IHatePdf.Models"
             xmlns:vm="clr-namespace:IHatePdf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConverterViewModel}"
             mc:Ignorable="d">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Converter para PDF" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                       Text="TXT e imagens (JPG, PNG, WEBP...) sao convertidos direto pelo app. DOCX e XLSX usam o LibreOffice em modo headless." />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
            <Button Content="Adicionar arquivos" Style="{StaticResource GhostButton}" Margin="0,0,26,8" Command="{Binding AddFilesCommand}" />
            <Button Content="Remover" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" />
            <Button Content="Limpar" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Command="{Binding ClearCommand}" />
        </WrapPanel>

        <!-- Pasta de saida -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox IsChecked="{Binding CombineImages}"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Uma pagina por imagem, na ordem da fila">
                    <TextBlock>
                        <Run Text="Juntar as imagens em um unico PDF" />
                        <Run Text="- arraste os cards para definir a ordem das paginas" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                </CheckBox>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Pasta de saida"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5" />

                <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />

                <!-- Margem so a esquerda: a do estilo (right=8) seria sobrescrita e colaria os dois botoes. -->
                <Button Grid.Column="2" Content="Escolher..."
                        Margin="12,0,0,0"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ChooseOutputFolderCommand}" />

                <Button Grid.Column="3" Content="Abrir pasta"
                        Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenOutputFolderCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DropZoneBorder}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource GlyphText}"
                               FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Solte arquivos TXT, DOCX, XLSX ou imagens aqui"
                               FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Style="{StaticResource PlainListBox}"
                         Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding ErrorMessage}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Extension}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SourcePath}"
                                               Style="{StaticResource SubtitleText}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock x:Name="StatusText"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Status, Converter={StaticResource ConversionStatusToText}}" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Concluido}">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Erro}">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Modo album: a ordem dos cards e a ordem das paginas, entao
                     a fila vira uma grade arrastavel, igual a do editor. -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.SelectDroppedItems="True"
                         dd:DragDrop.DragAdornerTemplate="{StaticResource DragCardAdorner}"
                         dd:DragDrop.DropTargetAdornerBrush="{DynamicResource AccentBrush}"
                         dd:DragDrop.DragMouseAnchorPoint="0.5,0.5"
                         dd:DragDrop.MinimumHorizontalDragDistance="6"
                         dd:DragDrop.MinimumVerticalDragDistance="6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Width="150"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Cursor="Hand"
                                    ToolTip="{Binding SourcePath}">
                                <StackPanel>
                                    <Grid Height="140">
                                        <Border Background="White"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxHeight="140">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000" />
                                            </Border.Effect>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Arquivo que nao e imagem entra na fila do mesmo jeito;
                                             sem previa, mostra a extensao. -->
                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Thumbnail, Converter={StaticResource EmptyToVisibility}}">
                                            <TextBlock Text="{Binding Extension}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <Border Style="{StaticResource CardBadge}"
                                                HorizontalAlignment="Left"
                                                ToolTip="Ordem desta pagina no PDF final">
                                            <TextBlock Text="{Binding DisplayNumber, Mode=OneWay}"
                                                       Style="{StaticResource CardBadgeText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding FileName}"
                                               Margin="0,10,0,0"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="StatusLine"
                                               Text="{Binding Status, Converter={StaticResource ConversionStatusToText}}"
                                               Style="{StaticResource SubtitleText}"
                                               FontSize="10.5" />
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Concluido}">
                                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Erro}">
                                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SubtitleText}" />
            <Button Content="Converter tudo"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Command="{Binding ConvertAllCommand}" />
        </Grid>
    </Grid>
</UserControl>
