<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara. Todos os controles usam DynamicResource nestas chaves,
         portanto trocar o dicionario em App.Resources troca o tema em tempo real. -->
    <Color x:Key="AccentColor">#E5322D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E1E3E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1D22" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5322D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C82722" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FDECEB" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#FAFAFB" />

</ResourceDictionary>
