<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta escura: mesmas chaves da Light.xaml. -->
    <Color x:Key="AccentColor">#FF5A55</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15171C" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#22262E" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2B303A" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#333944" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5A55" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7A76" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2320" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#1E2229" />

</ResourceDictionary>
